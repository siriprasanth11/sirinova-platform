# Copy this file to server/.env and fill in real values.
# server/.env is gitignored and never committed — Render needs its own
# copies of these same three variables set under the web service's
# Environment tab in the Render dashboard, or the deployed app won't have
# them even if your local .env is correct.

# MongoDB Atlas connection string
MONGO_URI=

# Gmail address used to send registration notifications
EMAIL_USER=

# Gmail App Password (NOT your regular Gmail login password).
# Generate one at https://myaccount.google.com/apppasswords
# — requires 2-Step Verification to be enabled on the account first.
EMAIL_PASS=
